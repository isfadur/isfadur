{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile in Isfadur Marketplace",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "Email address" },
        "displayName": { "type": "string", "description": "User full name" },
        "createdAt": { "type": "string", "description": "Account registration ISO date" },
        "favorites": { "type": "array", "description": "List of saved advertisement IDs" }
      },
      "required": ["uid", "email"]
    },
    "listing": {
      "title": "Listing",
      "description": "A marketplace classified advertisement for products, vehicles, property, or services in Bangladesh.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the listing"
        },
        "title": {
          "type": "string",
          "description": "Headline title of the advertisement"
        },
        "category": {
          "type": "string",
          "description": "Marketplace category"
        },
        "price": {
          "type": "number",
          "description": "Price in Bangladeshi Taka (BDT)"
        },
        "isNegotiable": {
          "type": "boolean",
          "description": "Whether the listed price is negotiable"
        },
        "condition": {
          "type": "string",
          "description": "Item condition"
        },
        "description": {
          "type": "string",
          "description": "Full details and description of the item or service"
        },
        "district": {
          "type": "string",
          "description": "Bangladesh district location"
        },
        "area": {
          "type": "string",
          "description": "Thana, sub-district, or area location"
        },
        "sellerName": {
          "type": "string",
          "description": "Seller or contact person's name"
        },
        "sellerPhone": {
          "type": "string",
          "description": "Bangladeshi contact mobile phone number"
        },
        "hasWhatsapp": {
          "type": "boolean",
          "description": "Whether WhatsApp chat is available on the contact number"
        },
        "images": {
          "type": "array",
          "description": "URLs of photos associated with the listing"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Moderation status of the advertisement"
        },
        "rejectionReason": {
          "type": "string",
          "description": "Explanation if rejected by moderator"
        },
        "views": {
          "type": "number",
          "description": "Total public views count"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO 8601 timestamp of when the advertisement was submitted"
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the listing is featured"
        }
      },
      "required": [
        "title",
        "category",
        "price",
        "description",
        "district",
        "area",
        "sellerName",
        "sellerPhone",
        "status",
        "createdAt"
      ]
    },
    "conversation": {
      "title": "Conversation",
      "description": "In-app messaging thread between buyer and seller",
      "type": "object",
      "properties": {
        "listingId": { "type": "string" },
        "listingTitle": { "type": "string" },
        "listingPrice": { "type": "number" },
        "sellerUid": { "type": "string" },
        "sellerName": { "type": "string" },
        "buyerUid": { "type": "string" },
        "buyerName": { "type": "string" },
        "participants": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastMessageAt": { "type": "string" },
        "lastSenderUid": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["listingId", "sellerUid", "buyerUid", "participants"]
    },
    "report": {
      "title": "Report",
      "description": "Safety, fraud, or violation reports on listings or users",
      "type": "object",
      "properties": {
        "reporterUid": { "type": "string" },
        "listingId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["reporterUid", "reason", "status", "createdAt"]
    },
    "moderationLog": {
      "title": "ModerationLog",
      "description": "Audit record of moderation decisions",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string" },
        "action": { "type": "string" },
        "targetId": { "type": "string" },
        "targetType": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["adminUid", "action", "targetId", "timestamp"]
    }
  },
  "firestore": {
    "/listings/{listingId}": {
      "schema": "listing",
      "description": "Public marketplace advertisements submitted by sellers"
    },
    "/users/{userId}": {
      "schema": "user",
      "description": "Registered user profile and metadata"
    },
    "/conversations/{conversationId}": {
      "schema": "conversation",
      "description": "In-app buyer-seller chat conversations"
    },
    "/reports/{reportId}": {
      "schema": "report",
      "description": "Reports submitted by users for moderation"
    },
    "/moderation_logs/{logId}": {
      "schema": "moderationLog",
      "description": "Audit records of admin moderation actions"
    }
  }
}
