rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents
    match /users/{userId} {
      // Users can read and write only their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /blocked_users/{blockedUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /listings/{listingId} {
      // Public can read active and approved listings; Owners can always read their own listings
      allow read: if resource == null
        || resource.data.status in ['approved', 'active']
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);

      // Authenticated users or guest submission
      allow create: if request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.category is string
        && (
          // If created by logged-in user, ownerUid must match their auth UID
          (request.auth != null && request.resource.data.ownerUid == request.auth.uid)
          || (request.resource.data.status == 'pending')
        );

      // Owner can update their own listing (cannot transfer ownership)
      // Public can increment views count
      allow update: if (
        request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1
      );

      // Ordinary users cannot permanently delete listings; preserves history
      allow delete: if false;
    }

    // In-App Conversations (Phase 3)
    match /conversations/{conversationId} {
      // Only authenticated participants can read and update conversations
      allow read, update: if request.auth != null && (request.auth.uid in resource.data.participants);

      // Authenticated users can create conversation where they are listed as participant
      allow create: if request.auth != null && (request.auth.uid in request.resource.data.participants);

      // Conversations cannot be deleted directly to preserve transaction history
      allow delete: if false;

      // Messages in conversation
      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        // Only participants can send a message, and senderUid must equal author UID
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);

        allow update, delete: if false;
      }
    }

    // Moderation and abuse reports
    match /reports/{reportId} {
      // Authenticated users can submit safety and abuse reports
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Moderation audit history logs
    match /moderation_logs/{logId} {
      // Ordinary users cannot read, write, modify, or delete moderation logs
      allow read, write: if false;
    }
  }
}
